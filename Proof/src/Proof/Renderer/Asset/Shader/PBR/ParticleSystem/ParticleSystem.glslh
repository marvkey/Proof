struct Particle
{
	vec3 Position;
	float Rotation;

	vec3 Velocity;
	float Life;

	vec4 Color;
	
	vec3 Size3D;
	int padding0;
};

struct ParticleEmission {
    float ParticlesPerSecond;
    float ParticlesPerDistance;
    int padding0;
    int padding1;
};

#define PARTICLE_SHAPE_CONE 0
#define PARTICLE_SHAPE_SPHERE 1
struct ParticleShape {
    int Shape;
    float RandomizeDirection;
    float SpherizeDirection;
    float RandomizePosition;

    int bEnabled;
    int padding0;
    int padding1;
    int padding2;

    //cone
	float ConeRadius;
	float ConeAngleDegrees; 
	int padding3;
	int padding4;

    // sphere
    float SphereRadius;
    int padding5;
    int padding6;
    int padding7;
};

struct ParticleVelocityOverLifetime {
    vec3 Linear;
    float SpeedModifier;

    vec3 Orbital;
    float Radial;

    vec3 Offset;
    int bEnabled;
};

struct ParticleColorOverLifetime {
    int bEnabled;
    int padding0;
    int padding1;
    int padding2;

    vec4 FinalColor;
};

struct ParticleSizeOverLifetime {
    vec3 FinalSize;
    int bEnabled;
};
// Main packed struct per emitter
struct ParticleEmitterSettings 
{
    ParticleEmission Emission;
    ParticleShape Shape;
    ParticleVelocityOverLifetime VelocityOverLifetime;
    ParticleColorOverLifetime ColorOverLife;
    ParticleSizeOverLifetime SizeOverLifeTime;
};


