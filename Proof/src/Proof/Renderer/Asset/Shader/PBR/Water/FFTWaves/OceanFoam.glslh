#ifndef OCEAN_FOAM_GLSLH
#define OCEAN_FOAM_GLSLH

#include <Common.glslh>
#include <PBR/Water/FFTWaves/FFTGlobal.glslh>
#include <PBR/Water/FFTWaves/OceanSimulation.glslh>

struct FoamInput
{
    mat4 derivatives;
    vec2 worldUV;
    float viewDist;
    vec4 lodWeights;
    vec4 shoreWeights;
    vec4 positionNDC;
    float viewDepth;
    float time;
    vec3 viewDir;
    vec3 normal;
};

struct FoamData
{
    vec2 coverage;
    vec3 normal;
    vec3 albedo;
};


vec2 RotateUV(vec2 uv, vec2 center, vec2 rotation, float sgn)
{
    uv -= center;
    float s = rotation.y;
    float c = rotation.x;
    mat2 rMatrix = mat2(c, -sgn * s, sgn * s, c);
    rMatrix = (rMatrix * 0.5) + 0.5;
    rMatrix = rMatrix * 2.0 - 1.0;
    uv = rMatrix * uv;
    uv += center;
    return uv;
}

vec4 MixTurbulence(mat4 t, vec4 foamWeights, vec4 mixWeights)
{
    return (t[0] * foamWeights.x + t[1] * foamWeights.y + t[2] * foamWeights.z + t[3] * foamWeights.w) / dot(foamWeights * mixWeights, vec4(1.0));
}

float DeepFoam(vec2 worldUV, vec3 viewDir, vec3 normal, float time)
{
    vec2 parallaxDir = (viewDir.xz / (dot(normal, viewDir)) + 0.5 * normal.xz);
    vec2 uv = worldUV - parallaxDir * GlobalStruct.UnderWaterFoamParallax - GlobalStruct.OceanWindDirection * time;
    uv = TransformTex(uv, GlobalStruct.FoamUnderwaterTexture_ST);
    float value = texture(u_FoamUnderwaterTexture, uv).r;
    return value;
}


vec2 Coverage(mat4 t, vec4 mixWeights, vec2 worldUV, float deepFoam, float bias)
{
    vec4 turbulence = MixTurbulence(t, GlobalStruct.OceanFoamCascadesWeights, mixWeights * GlobalStruct.ActiveCascades);
    float foamValueCurrent = mix(turbulence.y, turbulence.x, GlobalStruct.OceanFoamSharpness);
    float foamValuePersistent = (turbulence.z + turbulence.w) * 0.5;
    foamValueCurrent = mix(foamValueCurrent, foamValuePersistent, GlobalStruct.OceanFoamPersistence);
    foamValueCurrent -= 1.0;
    foamValuePersistent -= 1.0;
    
    float trailTexture;
    
    float trailTexture0 = texture(u_FoamTrailTexture, RotateUV(worldUV, vec2(0.0), GlobalStruct.OceanFoamTrailDirection0, 1.0) / GlobalStruct.OceanFoamTrailTextureSize0).r;
    
    if (GlobalStruct.OceanFoamTrailBlendValue > 0.0)
    {
        float trailTexture1 = texture(u_FoamTrailTexture, RotateUV(worldUV, vec2(0.0), GlobalStruct.OceanFoamTrailDirection1, 1.0) / GlobalStruct.OceanFoamTrailTextureSize1).r;
        trailTexture = mix(trailTexture0, trailTexture1, GlobalStruct.OceanFoamTrailBlendValue);
    }   
    else
    {
        trailTexture = trailTexture0;
    }
    
    foamValuePersistent += clamp(foamValuePersistent + 1.0, 0.0, 1.0) * trailTexture * GlobalStruct.OceanFoamTrailTextureStrength;
    float foamValue = max((foamValuePersistent + GlobalStruct.OceanFoamTrail * (1.0 - bias)), foamValueCurrent + GlobalStruct.OceanFoamCoverage * (1.0 - bias));
    
    float surfaceFoam = clamp(foamValue * GlobalStruct.OceanFoamDensity, 0.0, 1.0);
    float shallowUnderwaterFoam = clamp((foamValue + 0.1 * GlobalStruct.OceanFoamUnderwater) * GlobalStruct.OceanFoamDensity, 0.0, 1.0);
    float deepUnderwaterFoam = deepFoam * clamp((foamValue + GlobalStruct.OceanFoamUnderwater * 0.25) * GlobalStruct.OceanFoamDensity * 0.8, 0.0, 1.0);
    return vec2(surfaceFoam, max(shallowUnderwaterFoam, deepUnderwaterFoam));
}

float ContactFoam(vec4 positionNDC, float viewDepth, vec2 worldUV, float time)
{
    float depthDiff = LinearEyeDepth(texture(u_DepthMap, positionNDC.xy / positionNDC.w).r, GetZBufferParams()) 
        - viewDepth;
    float contactTexture = texture(u_ContactFoamTexture, TransformTex(worldUV, GlobalStruct.ContactFoamTexture_ST)).r;
    contactTexture = clamp(1.0 - contactTexture, 0.0, 1.0);
    depthDiff = abs(depthDiff) * contactTexture;
    return clamp(10.0 * (GlobalStruct.ContactFoam * 2.0 - depthDiff), 0.0, 1.0);
}

FoamData GetFoamData(FoamInput i)
{
    FoamData data;
    data.coverage = vec2(0.0);
    data.normal = vec3(0.0, 1.0, 0.0);
    data.albedo = vec3(1.0);
    
    #if !defined(WAVES_FOAM_ENABLED) && !defined(CONTACT_FOAM_ENABLED)
    return data;
    #endif
    
    #ifdef WAVES_FOAM_ENABLED
    mat4 turbulence = SampleTurbulence(i.worldUV, i.lodWeights * i.shoreWeights);
    float deepFoam = DeepFoam(i.worldUV, i.viewDir, i.normal, i.time);
    float bias = texture(_FoamDetailMap, TransformTex(i.worldUV, GlobalStruct.FoamDetailMap_ST) * 0.01).r;
    bias *= clamp(i.viewDist / Ocean_LengthScales.x * 0.5, 0.0, 1.0);
    data.coverage = Coverage(turbulence, i.lodWeights, i.worldUV, deepFoam, bias);
    data.coverage *= 1.0 - clamp((_WorldSpaceCameraPos.y + i.viewDist * 0.5 - 2000.0) * 0.0005, 0.0, 1.0);
    vec4 normalWeights = clamp(vec4(1.0, 0.66, 0.33, 0.0) + _FoamNormalsDetail, 0.0, 1.0) * GlobalStruct.ActiveCascades;
    data.normal = NormalFromDerivatives(i.derivatives, normalWeights);
    #endif
    
    #ifdef CONTACT_FOAM_ENABLED
    data.coverage.x = clamp(data.coverage.x + ContactFoam(i.positionNDC, i.viewDepth, i.worldUV, i.time), 0.0, 1.0);
    #endif
    
    vec2 uv = TransformTex(i.worldUV, GlobalStruct.FoamAlbedo_ST);
    data.albedo = texture(u_FoamAlbedo, uv).rgb;
    return data;
}


#endif //OCEAN_FOAM_GLSLH