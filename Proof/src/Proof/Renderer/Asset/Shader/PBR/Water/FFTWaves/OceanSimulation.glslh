#ifndef OCEAN_SIMULATION_GLSLH
#define OCEAN_SIMULATION_GLSLH
#include <PBR/Water/FFTWaves/FFTGlobal.glslh>

#define LOD_THRESHOLD 0.05

float EaseInOutClamped(float x)
{
    x = clamp(x, 0.0, 1.0);
    return 3.0 * x * x - 2.0 * x * x * x;
}

vec4 LodWeights(float viewDist, float lodScale)
{
    vec4 x = vec4(viewDist - GlobalStruct.OceanLengthScales * lodScale) / GlobalStruct.OceanLengthScales / lodScale;
    return vec4(1.0) - vec4(EaseInOutClamped(x.x), EaseInOutClamped(x.y), EaseInOutClamped(x.z), EaseInOutClamped(x.w));
}

vec3 SampleDisplacement(vec2 worldXZ, vec4 weights, vec4 shoreModulation)
{
    vec3 displacement = vec3(0.0);
    weights *= shoreModulation;
    
    displacement += weights[0] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales[0], 0 * 2), 0).xyz;
    
    if (weights[1] > LOD_THRESHOLD)
        displacement += weights[1] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales[1], 1 * 2), 0).xyz;
    
    if (GlobalStruct.ActiveCascades.z > 0.0)
        if (weights[2] > LOD_THRESHOLD)
            displacement += weights[2] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales[2], 2 * 2), 0).xyz;
    
    if (GlobalStruct.ActiveCascades.w > 0.0)
        if (weights[3] > LOD_THRESHOLD)
            displacement += weights[3] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales[3], 3 * 2), 0).xyz;
    
    return displacement;
}

float SampleHeight(vec2 worldPos, vec4 weights, vec4 shoreModulation)
{
    vec3 displacement = SampleDisplacement(worldPos, weights, shoreModulation);
    displacement = SampleDisplacement(worldPos - displacement.xz, weights, shoreModulation);
    displacement = SampleDisplacement(worldPos - displacement.xz, weights, shoreModulation);
    displacement = SampleDisplacement(worldPos - displacement.xz, weights, shoreModulation);
    
    return displacement.y;
}

mat4 SampleDerivatives(vec2 worldXZ, vec4 weights)
{
    mat4 o = mat4(0.0);
    
    o[0] = weights[0] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales.x, 0 * 2 + 1), 0).xyzw;
    
    if (weights[1] > LOD_THRESHOLD)
        o[1] = weights[1] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales.y, 1 * 2 + 1), 0).xyzw;
    
    if (GlobalStruct.ActiveCascades.z > 0.0)
        if (weights[2] > LOD_THRESHOLD)
            o[2] = weights[2] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales.z, 2 * 2 + 1), 0).xyzw;
    
    if (GlobalStruct.ActiveCascades.w > 0.0)
        if (weights[3] > LOD_THRESHOLD)
            o[3] = weights[3] * texelFetch(u_OceanDisplacementAndDerivatives, ivec3(worldXZ / GlobalStruct.OceanLengthScales.w, 3 * 2 + 1), 0).xyzw;
    
    return o;
}

mat4 SampleTurbulence(vec2 worldXZ, vec4 weights)
{
    mat4 o = mat4(0.0);
    
    o[0] = weights[0] * texelFetch(u_OceanTurbulence, ivec3(worldXZ / GlobalStruct.OceanLengthScales.x, 0), 0).xyzw;
    
    if (weights[1] > LOD_THRESHOLD)
        o[1] = weights[1] * texelFetch(u_OceanTurbulence, ivec3(worldXZ / GlobalStruct.OceanLengthScales.y, 1), 0).xyzw;
    
    if (GlobalStruct.ActiveCascades.z > 0.0)
        if (weights[2] > LOD_THRESHOLD)
            o[2] = weights[2] * texelFetch(u_OceanTurbulence, ivec3(worldXZ / GlobalStruct.OceanLengthScales.z, 2), 0).xyzw;
    
    if (GlobalStruct.ActiveCascades.w > 0.0)
        if (weights[3] > LOD_THRESHOLD)
            o[3] = weights[3] * texelFetch(u_OceanTurbulence, ivec3(worldXZ / GlobalStruct.OceanLengthScales.w, 3), 0).xyzw;
    
    return o;
}

vec3 NormalFromDerivatives(mat4 derivativesCascades, vec4 weights)
{
    vec4 derivatives = derivativesCascades[0] * weights[0]
        + derivativesCascades[1] * weights[1]
        + derivativesCascades[2] * weights[2]
        + derivativesCascades[3] * weights[3];
    
    vec2 slope = vec2(derivatives.x / max(0.001, 1.0 + derivatives.z),
                       derivatives.y / max(0.001, 1.0 + derivatives.w));
    
    return normalize(vec3(-slope.x, 1.0, -slope.y));
}

#endif //OCEAN_SIMULATION_GLSLH