
#ifndef FFT_WATER_COMPUTE
#define FFT_WATER_COMPUTE
struct SpectrumParameters 
{
	float Scale;
	float Angle;
	float SpreadBlend;
	float Swell;

	float Alpha;
	float PeakOmega;
	float Gamma;
	float ShortWavesFade;
};
layout(std140, set = 1, binding = 0) uniform FFTDataBuffer
{
    float DeltaTime;
    float A;
	float Gravity;
	float RepeatTime;
    
    float Damping;
    float Depth;
    float LowCutoff;
	float HighCutoff;

	vec2 Wind;
	vec2 Lambda;

	vec2 NormalStrength;
	int Seed;
	uint N;

    uint LengthScale0;
	uint LengthScale1;
	uint LengthScale2;
	uint LengthScale3;

	float FoamBias;
	float FoamDecayRate;
	float FoamAdd;
	float FoamThreshold;
} u_FFTData;

layout(std140, set = 1, binding = 1) buffer SpectrumParametersBuffer
{
	SpectrumParameters Spectrums[];
} s_Spectrum;

// Texture samplers
layout(set = 1, binding = 2, rgba16f) uniform image2DArray u_SpectrumTextures;
layout(set = 1, binding = 3, rgba16f) uniform image2DArray u_InitialSpectrumTextures;
layout(set = 1, binding = 4, rgba16f) uniform image2DArray u_DisplacementTextures;
layout(set = 1, binding = 5, rg16f) uniform image2DArray u_SlopeTextures;
layout(set = 1, binding = 6, r16f) uniform image2D u_BuoyancyData;
// Complex number multiplication
vec2 ComplexMult(vec2 a, vec2 b) 
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

// Euler's formula
vec2 EulerFormula(float x) 
{
    return vec2(cos(x), sin(x));
}

// Hash function
float Hash(uint n) 
{
    n = (n << 13U) ^ n;
   n = n * (n * n * 15731U + 7891U) + 519668U;  // Decimal equivalents
    return float(n & uint(0x7fffffffU)) / float(0x7fffffff);
}

// Convert uniform to Gaussian distribution
vec2 UniformToGaussian(float u1, float u2) 
{
    float R = sqrt(-2.0 * log(u1));
    float theta = 2.0 * PI * u2;
    return vec2(R * cos(theta), R * sin(theta));
}

// Dispersion relation
float Dispersion(float kMag) 
{
    return sqrt(u_FFTData.Gravity * kMag * tanh(min(kMag * u_FFTData.Depth, 20.0)));
}

// Dispersion derivative
float DispersionDerivative(float kMag) 
{
    float th = tanh(min(kMag * u_FFTData.Depth, 20.0));
    float ch = cosh(kMag * u_FFTData.Depth);
    return u_FFTData.Gravity * (u_FFTData.Depth * kMag / (ch * ch) + th) / Dispersion(kMag) / 2.0;
}

// Normalization factor
float NormalizationFactor(float s) 
{
    float s2 = s * s;
    float s3 = s2 * s;
    float s4 = s3 * s;
    if (s < 5.0) return -0.000564 * s4 + 0.00776 * s3 - 0.044 * s2 + 0.192 * s + 0.163;
    else return -4.80e-08 * s4 + 1.07e-05 * s3 - 9.53e-04 * s2 + 5.90e-02 * s + 3.93e-01;
}

// Donelan Banner Beta
float DonelanBannerBeta(float x) 
{
    if (x < 0.95) return 2.61 * pow(abs(x), 1.3);
    if (x < 1.6) return 2.28 * pow(abs(x), -1.3);

    float p = -0.4 + 0.8393 * exp(-0.567 * log(x * x));
    return pow(10.0, p);
}

// Donelan Banner
float DonelanBanner(float theta, float omega, float PeakOmega) 
{
    float beta = DonelanBannerBeta(omega / PeakOmega);
    float sech = 1.0 / cosh(beta * theta);
    return beta / 2.0 / tanh(beta * PI) * sech * sech;
}

// Cosine squared
float Cosine2s(float theta, float s) 
{
    return NormalizationFactor(s) * pow(abs(cos(0.5 * theta)), 2.0 * s);
}

// Spread power
float SpreadPower(float omega, float PeakOmega) {
    if (omega > PeakOmega)
        return 9.77 * pow(abs(omega / PeakOmega), -2.5);
    else
        return 6.97 * pow(abs(omega / PeakOmega), 5.0);
}

// Direction spectrum
float DirectionSpectrum(float theta, float omega, SpectrumParameters spectrum) 
{
    float s = SpreadPower(omega, spectrum.PeakOmega) + 16.0 * tanh(min(omega / spectrum.PeakOmega, 20.0)) * spectrum.Swell * spectrum.Swell;
    return mix(2.0 / PI * cos(theta) * cos(theta), Cosine2s(theta - spectrum.Angle, s), spectrum.SpreadBlend);
}

// TMA Correction
float TmaCorrection(float omega) 
{
    float omegaH = omega * sqrt(u_FFTData.Depth / u_FFTData.Gravity);
    if (omegaH <= 1.0)
        return 0.5 * omegaH * omegaH;
    if (omegaH < 2.0)
        return 1.0 - 0.5 * (2.0 - omegaH) * (2.0 - omegaH);
    return 1.0;
}

// JONSWAP Spectrum
float Jonswap(float omega, SpectrumParameters spectrum) 
{
    float sigma = (omega <= spectrum.PeakOmega) ? 0.07 : 0.09;
    float r = exp(-(omega - spectrum.PeakOmega) * (omega - spectrum.PeakOmega) / (2.0 * sigma * sigma * spectrum.PeakOmega * spectrum.PeakOmega));
    float oneOverOmega = 1.0 / omega;
    float peakOmegaOverOmega = spectrum.PeakOmega / omega;
    return spectrum.Scale * TmaCorrection(omega) * spectrum.Alpha * u_FFTData.Gravity * u_FFTData.Gravity
        * oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega
        * exp(-1.25 * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega)
        * pow(abs(spectrum.Gamma), r);
}

// Short waves fade
float ShortWavesFade(float kLength, SpectrumParameters spectrum) 
{
    return exp(-spectrum.ShortWavesFade * spectrum.ShortWavesFade * kLength * kLength);
}

vec2 ComplexExp(vec2 a) 
{
    return vec2(cos(a.y), sin(a.y) * exp(a.x));
}

vec4 ComputeTwiddleFactorAndInputIndices(uvec2 id) 
{
    uint b = u_FFTData.N >> (id.x + 1);
    vec2 mult = 2.0 * PI * vec2(0.0, 1.0) / float(u_FFTData.N);
    uint i = (2u * b * (id.y / b) + id.y % b) % u_FFTData.N;
    vec2 twiddle = vec2(cos(-mult.y * (id.y / b) * b), sin(-mult.y * (id.y / b) * b));

    return vec4(twiddle, float(i), float(i + b));
}


#endif // FFT_WATER_COMPUTE


