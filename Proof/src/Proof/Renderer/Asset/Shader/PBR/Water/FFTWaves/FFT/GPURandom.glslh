#ifndef GPU_RANDOM_GLSL_H
#define GPU_RANDOM_GLSL_H

uint BaseHash(uvec3 p)
{
	p = 1103515245U * ((p.xyz >> 1U) ^ (p.yzx));
	uint h32 = 1103515245U * ((p.x ^ p.z) ^ (p.y >> 3U));
	return h32 ^ (h32 >> 16);
}

float Hash13(uvec3 x) 
{
    uint n = BaseHash(x).x;
    return float(n) * (1.0 / 4294967295.0); // 0xffffffffU = 4294967295.0
}

vec2 Hash23(vec3 x) 
{
    uvec3 ix = floatBitsToUint(x);
    uint n = BaseHash(ix).x;
    uvec2 rz = uvec2(n, n * 48271U);
    return vec2(rz & uvec2(0x7fffffffU)) / 2147483647.0; // 0x7fffffffU = 2147483647.0
}

vec3 Hash33(uvec3 x) 
{
    uint n = BaseHash(x).x;
    uvec3 rz = uvec3(n, n * 16807U, n * 48271U);
    return vec3(rz & uvec3(0x7fffffffU)) / 2147483647.0; // 0x7fffffffU = 2147483647.0
}

#endif // GPU_RANDOM_GLSL_H