#ifndef OCEAN_VOLUME_GLSLH
#define OCEAN_VOLUME_GLSLH
#include <PBR/Water/FFTWaves/FFTGlobal.glslh>
#include <Common.glslh>

// Function to compute color through water
vec3 ColorThroughWater(vec3 color, vec3 volumeColor, float distThroughWater, float depth)
{
    distThroughWater = max(0.0, distThroughWater);
    depth = max(0.0, depth);
    // Compute absorption tint based on distance and depth
    vec3 absorptionTint = AbsorptionTint(exp(-(distThroughWater + depth) / GlobalStruct.OceanAbsorptionDepthScale));
    color *= absorptionTint;
    // Compute fog factor
    float fogFactor = 1.0 - clamp(exp(-GlobalStruct.OceanFogDensity * distThroughWater),0,1);
    return mix(color, volumeColor, fogFactor);
}

// Function to compute underwater fog color
vec3 UnderwaterFogColor(vec3 viewDir, vec3 lightDir, float depth)
{
    float depthScale = 0.0; // Adjust as needed
    float bias = min(0.0, depth * 0.02);
    // Compute subsurface scattering factor
    float sssFactor = 0.1 * pow(max(0.0, 1.0 - viewDir.y + bias), 3.0);
    sssFactor *= 1.0 + pow(clamp(dot(lightDir, -viewDir),0,1), 4.0);
    sssFactor *= Saturate(1.0 - depthScale);
    // Compute color
    vec3 color = DeepScatterColor(depthScale) * max(0.5, Saturate(2.0 - viewDir.y + bias));
    vec3 sssColor = SssColor(depthScale);
    color += sssColor * sssFactor;
    return color;
}


#endif //OCEAN_VOLUME_GLSLH