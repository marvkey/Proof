vec3 DeepScatterColor(float t)
{
    return GlobalStruct.OceanDeepScatterColor;
}

vec3 SssColor(float t)
{
    return GlobalStruct.OceanSssColor;
}

vec3 DiffuseColor(float t)
{
    return GlobalStruct.OceanDiffuseColor;
}

vec3 AbsorptionTint(float t)
{
    vec4 colors[GRADIENT_MAX_KEYS] =
    {
        GlobalStruct.OceanAbsorptionColor0,
        GlobalStruct.OceanAbsorptionColor1,
        GlobalStruct.OceanAbsorptionColor2,
        GlobalStruct.OceanAbsorptionColor3,
        GlobalStruct.OceanAbsorptionColor4,
        GlobalStruct.OceanAbsorptionColor5,
        GlobalStruct.OceanAbsorptionColor6,
        GlobalStruct.OceanAbsorptionColor7
    };
    Gradient g = CreateGradient(colors, GlobalStruct.OceanAbsorptionGradientParams);
    return SampleGradient(g, t);
}

#endif //FFT_GLOBAL_GLSLH