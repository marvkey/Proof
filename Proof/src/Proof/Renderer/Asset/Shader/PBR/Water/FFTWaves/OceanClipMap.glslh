#ifndef OCEAN_CLIP_MAP_GLSLH
#define OCEAN_CLIP_MAP_GLSLH
#include <PBR/Water/FFTWaves/FFTGlobal.glslh>

//https://github.com/gasgiant/Ocean-URP/blob/47db0cdd15ae12334a73c82735666bcbd1c48476/Assets/OceanSystem/Shaders/GeoClipMap.hlsl#L13
float ModifiedManhattanDistance(vec3 a, vec3 b) 
{
    vec3 v = a - b;
    return max(abs(v.x + v.z) + abs(v.x - v.z), abs(v.y)) * 0.5;
}

vec3 ClipMapVertex(vec3 positionOS, vec2 uv) 
{
    vec3 morphOffset = vec3(uv.x, 0.0, uv.y);
    positionOS *= GlobalStruct.ClipMapScale;  // Assuming ClipMapScale is defined as a uniform or constant
    float meshScale = positionOS.y;
    float step = meshScale * 4.0;

    vec3 snappedViewerPos = vec3(floor(GlobalStruct.ClipMapViewerPosition.x / step) * step, 0.0, floor(GlobalStruct.ClipMapViewerPosition.z / step) * step);
    vec3 worldPos = vec3(snappedViewerPos.x + positionOS.x, 0.0, snappedViewerPos.z + positionOS.z);

    float morphStart = ((GlobalStruct.ClipMapLevelHalfSize + 1.0) * 0.5 + 8.0) * meshScale;
    float morphEnd = (GlobalStruct.ClipMapLevelHalfSize - 2.0) * meshScale;

    float t = clamp((ModifiedManhattanDistance(worldPos, GlobalStruct.ClipMapViewerPosition) - morphStart) / (morphEnd - morphStart), 0.0, 1.0);
    worldPos += morphOffset * meshScale * t;
    return worldPos;
}
#endif //OCEAN_CLIP_MAP_GLSLH
