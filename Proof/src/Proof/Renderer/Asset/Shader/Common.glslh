#ifndef COMMON_GLSL_H
#define COMMON_GLSL_H

const float PI = 3.14159265358979323846264338327950288f;
const float TWO_PI = 2 * PI;
const float Epsilon = 0.00001;
#define CUSTOM_OUTPUT_SLOT_VERTEX_FRAGMENT_PBR 24
layout(set = 3, binding = 0) uniform FrameData
{
	uint FrameCount;
	float AppTimeSeconds;
    float DeltaTime;
}u_FrameData;

float Log10(float x) 
{
    return log(x) / log(10.0);
}
layout(set = 3, binding = 1) uniform CameraData
{
  	mat4 Projection;
	mat4 InverseProjection;
	mat4 UnreversedProjectionMatrix;
	mat4 View;
	mat4 InverseView;
	mat4 ViewProjectionMatrix;// projection * view
	mat4 InverseViewProjectionMatrix;  //inversProjection * view

	mat4 PrevViewProjectionMatrix; // project * view from last frame

	vec3 Position; //world space
	float NearPlane;

	float FarPlane;
	float Fov;
	vec2 NDCToViewMul;

	vec2 NDCToViewAdd;
	vec2 DepthUnpackConsts;

	vec2 JitterData;// Halton sequence jitter data
	vec2 PrevJitterData;// Halton sequence jitter data

	vec3 ViewDirection;
	uint JitterPeriod;        // jitter period for jitter data.

	bool bEnableJitter;       // Is main camera enable jitter in this frame.

} u_Camera;

layout (set = 3, binding = 2) uniform ScreenData
{
	vec2 FullResolution;
	vec2 InverseFullResolution;
	vec2 HalfResolution;
	vec2 InverseHalfResolution;
	float AspectRatio;
	float ResolutionScaling;
} u_ScreenData;

layout(set = 3, binding = 3) uniform sampler u_PointClampEdgeSampler;
layout(set = 3, binding = 4) uniform sampler u_PointClampBorder0000Sampler;
layout(set = 3, binding = 5) uniform sampler u_PointRepeatSampler;
layout(set = 3, binding = 6) uniform sampler u_PointClampBorder1111Sampler;

layout(set = 3, binding = 7) uniform sampler u_LinearClampEdgeSampler;
layout(set = 3, binding = 8) uniform sampler u_LinearClampBorder0000Sampler;
layout(set = 3, binding = 9) uniform sampler u_LinearRepeatSampler;
layout(set = 3, binding = 10) uniform sampler u_LinearClampBorder1111Sampler;

// With mip filter
layout(set = 3, binding = 11) uniform sampler u_LinearClampEdgeMipFilterSampler;
layout(set = 3, binding = 12) uniform sampler u_LinearRepeatMipFilterSampler;

layout(set = 3, binding = 13) uniform sampler u_LinearSampler;
layout(set = 3, binding = 14) uniform sampler u_PointSampler;

float ConvertSRGBFromLinear(float value)
{
	return value <= 0.0031308f ? value * 12.92f : pow(value, 1.0f / 2.4f) * 1.055f - 0.055f;
}

vec3 RotateAroundYAxis(float angle, vec3 axis)
{
	float rad = radians(angle);
	mat3x3 rotationMatrix = {
		vec3(cos(rad), 0.0, sin(rad)),
		vec3(0.0, 1.0, 0.0),
		vec3(-sin(rad), 0.0, cos(rad))
	};
	
	return rotationMatrix * axis;
}
// Convert clip space coordinates to view space
vec4 ClipToView(vec4 clip)
{
    // View space position.
    vec4 view = u_Camera.InverseProjection * clip;
    // Perspective division.
     view = view / view.w;

    return view;
}

vec4 WorldPositionToClipPosition(vec3 worldPosition)
{
      // Transform the world space position to view space
    vec4 viewPosition = u_Camera.View * vec4(worldPosition,1.0);

    // Transform the view space position to clip space
    vec4 clipPosition = u_Camera.Projection * viewPosition;

    return clipPosition;
}
// Convert screen space coordinates to view space.
vec4 ScreenToView(vec4 screen)
{
    // Convert to normalized texture coordinates
    vec2 texCoord = screen.xy / u_ScreenData.FullResolution;

    // Convert to clip space
    vec4 clip = vec4(vec2(texCoord.x, 1.0 - texCoord.y) * 2.0 - 1.0, screen.z, screen.w);

    return ClipToView(clip);
}

//float LinearizeDepth(float z)
//{
//	return u_Camera.FarPlane / (u_Camera.FarPlane + z * (u_Camera.NearPlane - u_Camera.FarPlane));
//}

// GLSL equivalent for Linear01Depth
float Linear01Depth(float z) {
    return (u_Camera.FarPlane / (u_Camera.FarPlane - u_Camera.NearPlane)) * (z - u_Camera.NearPlane);
}

mat4 GetWorldToObjectMatrix(mat4 modelMatrix) 
{
    return inverse(modelMatrix);
}

vec4 TransformWorldToObject(mat4 modelMatrix,vec4 positionWS)
{
    return vec4(GetWorldToObjectMatrix(modelMatrix) * positionWS);
}

vec4 TransformObjectToWorld(mat4 modelMatrix,vec4 positionWS)
{
    return modelMatrix * positionWS;
}

vec4 TransformWorldToView(vec4 positionWS) 
{
    return u_Camera.View * positionWS;
}

vec4 TransformWorldToHClip(vec4 positionWS) 
{
    return u_Camera.Projection * positionWS;
}

// Overloaded functions for vec3 positions
vec3 TransformObjectToWorld(mat4 modelMatrix,vec3 positionOS) 
{
    return TransformObjectToWorld(modelMatrix,vec4(positionOS, 1.0)).xyz;
}

vec3 TransformWorldToView(vec3 positionWS) 
{
    return TransformWorldToView(vec4(positionWS, 1.0)).xyz;
}

vec4 TransformWorldToHClip(vec3 positionWS) 
{
    return TransformWorldToHClip(vec4(positionWS, 1.0));
}
vec3 TransformWorldToObject(mat4 modelMatrix,vec3 positionWS)
{
    return vec4(GetWorldToObjectMatrix(modelMatrix) * vec4(positionWS,1.0)).xyz;
}
vec3 GetViewPosition(vec2 texcoord, float depth)
{
	vec4 clipSpaceLocation;
	clipSpaceLocation.xy = texcoord * 2.0f - 1.0f;
	clipSpaceLocation.y *= -1;
	clipSpaceLocation.z = depth;
	clipSpaceLocation.w = 1.0f;
	vec4 homogenousLocation = clipSpaceLocation * u_Camera.InverseProjection;
	return homogenousLocation.xyz / homogenousLocation.w;
}

float luminance(vec3 color)
{
    // human eye aware lumiance function.
    return dot(color, vec3(0.299, 0.587, 0.114));
}

uint FFX_DNSR_Reflections_BitfieldExtract(uint src, uint off, uint bits) {
    uint mask = (1u << bits) - 1u;
    return (src >> off) & mask;
}

uint FFX_DNSR_Reflections_BitfieldInsert(uint src, uint ins, uint bits) {
    uint mask = (1u << bits) - 1u;
    return (ins & mask) | (src & (~mask));
}

// LANE TO 8x8 MAPPING
// ===================
// 00 01 08 09 10 11 18 19
// 02 03 0a 0b 12 13 1a 1b
// 04 05 0c 0d 14 15 1c 1d
// 06 07 0e 0f 16 17 1e 1f
// 20 21 28 29 30 31 38 39
// 22 23 2a 2b 32 33 3a 3b
// 24 25 2c 2d 34 35 3c 3d
// 26 27 2e 2f 36 37 3e 3f
uvec2 Remap8x8(uint lane) {
//https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK/blob/d7531ae47d8b36a5d4025663e731a47a38be882f/sdk/include/FidelityFX/gpu/denoiser/ffx_denoiser_reflections_common.h#L72
    return uvec2(FFX_DNSR_Reflections_BitfieldInsert(
                    FFX_DNSR_Reflections_BitfieldExtract(lane, 2u, 3u), 
                    lane, 
                    1u),
                 FFX_DNSR_Reflections_BitfieldInsert(
                    FFX_DNSR_Reflections_BitfieldExtract(lane, 3u, 3u), 
                    FFX_DNSR_Reflections_BitfieldExtract(lane, 1u, 2u), 
                    2u));
}

// Build one TBN matrix from normal input.
// 
mat3 CreateTBN(vec3 N) 
{
    vec3 U;
    if (abs(N.z) > 0.0) 
    {
        float k = sqrt(N.y * N.y + N.z * N.z);
        U.x = 0.0; 
        U.y = -N.z / k; 
        U.z = N.y / k;
    }
    else 
    {
        float k = sqrt(N.x * N.x + N.y * N.y);
        U.x = N.y / k; 
        U.y = -N.x / k; 
        U.z = 0.0;
    }

    mat3 TBN = mat3(U, cross(N, U), N);
    return transpose(TBN);
}

void SinCos(float angle, out float sine, out float cosine) 
{
    sine = sin(angle);
    cosine = cos(angle);
}

float DotClamped(vec3 a, vec3 b) 
{
    float dotProduct = dot(a, b);
    return clamp(dotProduct, 0.0, dotProduct);
}

struct VertexPositionInputs
{
    vec3 PositionWS; // World space position
    vec3 PositionVS; // View space position
    vec4 PositionCS; // Homogeneous clip space position
    vec4 PositionNDC;// Homogeneous normalized device coordinates
};
 
struct VertexNormalInputs
{
    vec3 tangentWS;
    vec3 bitangentWS;
    vec3 normalWS;
};
VertexPositionInputs GetVertexPositionInputs(mat4 modelMatrix,vec3 positionOS) 
{
    VertexPositionInputs inputt;
    
    // Transform position from object space to world space
    inputt.PositionWS = TransformObjectToWorld(modelMatrix,positionOS);
    
    // Transform position from world space to view space
    inputt.PositionVS = TransformWorldToView(inputt.PositionWS);
    
    // Transform position from world space to clip space
    inputt.PositionCS = TransformWorldToHClip(inputt.PositionWS);
    
    // Perspective division to convert from clip space to NDC
    vec4 ndc = inputt.PositionCS * 0.5f;
    
    // Apply projection parameters
    float projectionParamsX = 1.0f; //not sure check unity cause dont understad
    inputt.PositionNDC.xy = vec2(ndc.x, ndc.y * projectionParamsX) + ndc.w;
    inputt.PositionNDC.zw = inputt.PositionCS.zw;
    
    return inputt;
}
vec2 TransformTex(vec2 uv, vec4 st)
{
    return uv * st.xy + st.zw;
}

vec4 GetZBufferParams()
{
    // Compute the parameters based on the near and far plane distances
    float x = 1.0 / (u_Camera.FarPlane - u_Camera.NearPlane);
    float y = u_Camera.FarPlane * u_Camera.NearPlane / (u_Camera.NearPlane - u_Camera.FarPlane);
    float z = (1.0 - u_Camera.FarPlane / u_Camera.NearPlane) / u_Camera.FarPlane;
    float w = (u_Camera.FarPlane / u_Camera.NearPlane) / u_Camera.FarPlane;
    
    // Return as vec4
    return vec4(x, y, z, w);
}
float LinearEyeDepth( float z,vec4 zBuffer )
{
	//(n * f) / (f - z * (f - n))
	return 1.0 / (zBuffer.z * z + zBuffer.w);
}

float Saturate(float val)
{
    return clamp(val,0,1);
}


#endif // COMMON_GLSL_H